# ==========================================
# SpendWise AI - Master Environment Config
# ==========================================

# Server Settings (Local Development)
HOST=127.0.0.1
PORT=5000

# Frontend API Configuration
VITE_API_BASE_URL=/api

# Supabase Project Credentials (Required for Production Database)
# Retrieve from Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional AI LLM Keys for Enhanced Real-Time Intelligent Insights
GEMINI_API_KEY=
OPENAI_API_KEY=
